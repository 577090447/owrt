#!/bin/sh
# SPDX-License-Identifier: MIT
# IPQ60XX eMMC - Docker 首次启动自动初始化
# 作用：启用 dockerd、data_root 指向 /opt/docker、限制日志防 eMMC 写爆

set -e

DOCKER_CONFIG="/etc/config/dockerd"
DAEMON_JSON="/etc/docker/daemon.json"
DOCKER_DATA="/opt/docker"

# 1. 确保数据目录存在
mkdir -p "$DOCKER_DATA"

# 2. 配置 dockerd：data_root 指向 /opt/docker
if [ -f "$DOCKER_CONFIG" ]; then
    uci set dockerd.globals.data_root="$DOCKER_DATA"
    uci commit dockerd
fi

# 3. 写入 daemon.json：overlay2 + 日志限制
mkdir -p "/etc/docker"
cat > "$DAEMON_JSON" <<EOF
{
  "storage-driver": "overlay2",
  "data-root": "$DOCKER_DATA",
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
EOF

# 4. 启用并启动 dockerd
if [ -x "/etc/init.d/dockerd" ]; then
    /etc/init.d/dockerd enable
    /etc/init.d/dockerd start
fi

# 5. 写入锁定标记，方便排查是否执行过
touch /etc/.docker_locked

exit 0
