#!/bin/sh
# Auto bind ZeroTier zt* interface into UCI network 'ZeroTier' zone
# Runs once at first boot (uci-defaults), idempotent.
ZTDEV=$(ls /sys/class/net 2>/dev/null | grep '^zt' | head -n1)
if [ -n "$ZTDEV" ]; then
	uci -q get network.ZeroTier >/dev/null || uci set network.ZeroTier=interface
	uci set network.ZeroTier.proto='none'
	uci set network.ZeroTier.device="$ZTDEV"
	uci commit network
fi
exit 0
